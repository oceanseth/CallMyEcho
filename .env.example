# Copy this file to .env and fill in your actual API keys

# Hume AI Credentials (for EVI - complete speech-to-speech processing)
# Get from: https://dev.hume.ai/docs/introduction/api-key
HUME_API_KEY=your_hume_api_key_here
HUME_SECRET_KEY=your_hume_secret_key_here

# Twilio Credentials (for webhook validation)
# Get from: https://console.twilio.com/
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# AWS Configuration (optional, can use aws configure instead)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1